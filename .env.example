# Copy to .env (gitignored) and fill in. Never commit the real .env.

# Expert capture model: "mock" (offline) or "adp" (Tencent Cloud ADP)
TBC_LLM_PROVIDER=adp

# From the ADP console: your app > Publish > Service status > API management > Copy
ADP_APP_KEY=

# Optional: override the endpoint (default is the international v2 endpoint)
# ADP_ENDPOINT=https://wss.lke.tencentcloud.com/adp/v2/chat

# Optional: set to 0 to keep all state in memory
# TBC_PERSIST=1

# Signs the session cookie set by POST /login. Set this outside a demo --
# with no value, a random secret is generated per process, so sessions
# don't survive a restart.
# TBC_SECRET=

# Optional: set to 1 to let ?user=<id> stand in for a session cookie when
# none is present (local demos/tests only). A session cookie always wins
# over ?user= even when this is set. Off by default.
# TBC_DEMO_INSECURE=0
